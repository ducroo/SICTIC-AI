# LOGGING
# Optional: DEBUG (default), INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=
# Set to 1 to show normally suppressed native-library warnings.
SICTIC_SHOW_NATIVE_WARNINGS=0

# DOCUMENT CONVERSION
# Optional: defaults to the local Docling-centred conversion stack.
DOCUMENT_CONVERTER=docling_stack

# PARALLELISM
# Model endpoints
# LLM_* controls text generation. VLM_* controls image/chart descriptions.
# EMBEDDING_* controls semantic search.
# Leave *_API_KEY blank for local Ollama or providers that use their own env vars.
LLM_MODEL="ollama/qwen3:8b"
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_REQUEST_TIMEOUT=1200

VLM_MODEL="ollama/qwen3-vl:8b"
VLM_BASE_URL=http://localhost:11434
VLM_API_KEY=

EMBEDDING_MODEL="ollama/qwen3-embedding:8b"
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_REQUEST_TIMEOUT=300

# RETRIEVAL
# Dense and BM25 results are fused in Qdrant. These tune what happens after.
# RETRIEVAL_CANDIDATE_MULTIPLIER: how many candidates to retrieve per returned
# chunk, giving reranking and diversification room to work.
# RETRIEVAL_MAX_DOCUMENT_SHARE: largest share of the returned chunks that any
# single document may occupy. Use 0 or 1 to disable the cap.
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_MAX_DOCUMENT_SHARE=0.4

# Optional cross-encoder reranking. Blank RERANK_MODEL disables it.
# Ollama does not currently expose the rerank API required here. A local
# Infinity server can use RERANK_MODEL="infinity/BAAI/bge-reranker-v2-m3" with
# RERANK_BASE_URL=http://localhost:7997
RERANK_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_REQUEST_TIMEOUT=120

CLOUD_TPM_BUDGET=1000000
SCHEDULER_LEASE_MAX_AGE=1800

OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_CONTEXT_LENGTH_MAX=262144
OLLAMA_NUM_PARALLEL=8
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1

# the llm outputs in descending order of preference
RANKED_LLMS="gemini3.1-pro-preview, gemini-3.1-flash-lite, gemma4:31b-nvfp4, qwen3:8b"


QDRANT_HOST=http://localhost:6333
OLLAMA_HOST=http://localhost:11434

# Absolute local application storage path. The installer suggests
# <REPO_PATH>/local_storage.
LOCAL_STORAGE_PATH=

# Absolute local runtime cache path for cache/ and docling_data/.
# Defaults to REPO_PATH during install.
LOCAL_DATA_PATH=

#SECRETS
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
APIFY_KEY=
DEALUM_API_KEY=
DEALUM_DEALROOM_ID=
DEALUM_SYNC_TTL_SECONDS=21600

#LOCAL PATHS
REPO_PATH=
INSTALLED_SKILLS_PATH=
