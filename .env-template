# GATEWAY LIMITS
MAX_CONCURRENT_EMBEDS=16
MAX_CONCURRENT_LLMS=10
MAX_CONCURRENT_DOCLING=16

#LLMs "gemini/gemini-3-pro-preview" "ollama/qwen3:30b"
DEFAULT_LLM="ollama/qwen3:8b"
DEFAULT_VLM="ollama/qwen3-vl:8b"
DEFAULT_EMBEDDINGS="ollama/qwen3-embedding:8b"
OLLAMA_MAX_CONTEXT=32768
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=16
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1

# the llm outputs in descending order of preference
RANKED_LLMS="gemini3.1-pro-preview, gemini-3.1-flash-lite, gemma3:27b, qwen3:30b, qwen3:8b, qwen3:4b"


QDRANT_HOST=http://localhost:6333
OLLAMA_HOST=http://localhost:11434

# Storage Configuration
# STORAGE_PROVIDER: "local" or "google"
STORAGE_PROVIDER="local"

# If local: An absolute directory path (e.g., /Users/claw-agent/temp/)
# If google: A Google Drive Folder ID (e.g., 1A2B3C...) or "root"
STORAGE_PATH=

# (Optional) Google Drive Credentials
# Defaults to ~/.openclaw/gdrive-ops-credentials.json if empty
GDRIVE_CREDENTIALS=
GDRIVE_TOKEN=

#SECRETS
GEMINI_API_KEY=
APIFY_KEY=
DEALUM_API_KEY=

#LOCAL DIRECTORIES
CACHE_DIR=
WORKSPACE_DIR=

