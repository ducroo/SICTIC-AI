# PARALLELISM
# Model endpoints
# LLM_* controls text generation. VLM_* controls image/chart descriptions.
# EMBEDDING_* controls semantic search.
# Leave *_API_KEY blank for local Ollama or providers that use their own env vars.
LLM_MODEL="ollama/qwen3:8b"
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

VLM_MODEL="ollama/qwen3-vl:8b"
VLM_BASE_URL=http://localhost:11434
VLM_API_KEY=

EMBEDDING_MODEL="ollama/qwen3-embedding:8b"
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=

OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_CONTEXT_LENGTH_MAX=262144
OLLAMA_NUM_PARALLEL=16
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1

# the llm outputs in descending order of preference
RANKED_LLMS="gemini3.1-pro-preview, gemini-3.1-flash-lite, gemma4:31b-nvfp4, qwen3:8b"


QDRANT_HOST=http://localhost:6333
OLLAMA_HOST=http://localhost:11434

# Document parsing backend: docling (local, default) or llamaparse (LlamaCloud SaaS).
DOCUMENT_PARSER=docling
# LLAMA_CLOUD_API_KEY=
# LLAMA_PARSE_TIER=cost_effective
# LLAMA_PARSE_VERSION=latest

# Vector store backend: qdrant (local, default) or firestore (Firebase).
VECTOR_STORE=qdrant
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Absolute local application storage path.
LOCAL_STORAGE_PATH=

# Absolute local runtime cache path for cache/ and docling_data/.
# Defaults to REPO_PATH during install.
LOCAL_DATA_PATH=

# Cloud provider and root. CLOUD_STORAGE_PATH may be a Google Drive folder ID,
# "root", or a folder path/name such as "SICTIC-AI" or "SICTIC-AI/prod".
CLOUD_PROVIDER=google
CLOUD_STORAGE_PATH=

# (Optional) Google Drive Credentials
# Prefer JSON secrets in Cloud Agents (materialized to files on install/start):
#   GDRIVE_CREDENTIALS_JSON  Desktop OAuth client secrets JSON
#   GDRIVE_TOKEN_JSON        Authorized-user token JSON
# Path vars below point at the written files (defaults under ~/.openclaw/):
GDRIVE_CREDENTIALS=
GDRIVE_TOKEN=

#SECRETS
GEMINI_API_KEY=
APIFY_KEY=
DEALUM_API_KEY=
DEALUM_DEALROOM_ID=
DEALUM_SYNC_TTL_SECONDS=21600

#LOCAL PATHS
REPO_PATH=
INSTALLED_SKILLS_PATH=
