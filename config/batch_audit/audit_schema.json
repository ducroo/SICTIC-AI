{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "skill",
    "checklist_title",
    "dataset",
    "model",
    "generated_at",
    "response_schema",
    "chapters"
  ],
  "properties": {
    "schema_version": {},
    "skill": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "checklist_title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "dataset": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "response_schema": {
      "type": "object"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "number",
        "check",
        "result",
        "error"
      ],
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/assessment"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          }
        }
      }
    },
    "chapter": {
      "type": "object",
      "required": [
        "number",
        "title",
        "checks"
      ],
      "properties": {
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    }
  }
}
