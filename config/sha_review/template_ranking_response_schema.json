{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rankings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "template_key": {
            "type": "string",
            "minLength": 1,
            "description": "Exact key from the supplied reference-template dictionary."
          },
          "rationale_for_rank": {
            "type": "string",
            "minLength": 1,
            "description": "Concise explanation of this template's ranking relative to the other templates."
          }
        },
        "required": [
          "template_key",
          "rationale_for_rank"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "rankings"
  ]
}
