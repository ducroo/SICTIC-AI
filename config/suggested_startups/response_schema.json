{
  "title": "SuggestedStartupsResponse",
  "type": "object",
  "properties": {
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "startup_name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of a startup from the supplied candidate set."
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "description": "One-based rank, ordered from best to worst fit."
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "Critical assessment of alignment and material gaps."
          }
        },
        "required": [
          "startup_name",
          "rank",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "suggestions"
  ],
  "additionalProperties": false
}
