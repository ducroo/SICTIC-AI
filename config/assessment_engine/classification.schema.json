{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment-engine/classification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label", "variant", "confidence", "uncertain", "ambiguity_reason", "override_reason",
    "provenance", "evidence_ids", "applicability"
  ],
  "properties": {
    "label": {"type": "string", "minLength": 1},
    "variant": {"type": ["string", "null"], "minLength": 1},
    "confidence": {"type": "string", "minLength": 1},
    "uncertain": {"type": "boolean"},
    "ambiguity_reason": {"type": ["string", "null"], "minLength": 1},
    "override_reason": {"type": ["string", "null"], "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "basis", "evidence_ids", "provenance"],
      "properties": {
        "state": {"enum": ["applicable", "not_applicable", "unknown"]},
        "basis": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
