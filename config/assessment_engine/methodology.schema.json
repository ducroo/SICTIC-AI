{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment-engine/methodology.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "general_variant", "policy", "applicability_rules", "variants"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "general_variant": {"type": ["string", "null"], "minLength": 1},
    "policy": {"$ref": "#/$defs/policy"},
    "applicability_rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/applicabilityRule"}
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/variant"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification_vocabulary", "confidence_vocabulary", "applicability_vocabulary", "evidence_reference_policy", "applicability_decision_policy",
        "unknown_is_incomplete", "ambiguity_reason_required", "override_reason_required"
      ],
      "properties": {
        "classification_vocabulary": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "confidence_vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "applicability_vocabulary": {
          "type": "array",
          "const": ["applicable", "not_applicable", "unknown"]
        },
        "evidence_reference_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "allow_unreferenced"],
          "properties": {
            "required": {"const": true},
            "allow_unreferenced": {"type": "boolean"}
          }
        },
        "applicability_decision_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis_vocabulary", "evidence_required_for_non_default", "evidence_required_for_exclusion", "provenance_required"],
          "properties": {
            "basis_vocabulary": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "evidence_required_for_non_default": {"const": true},
            "evidence_required_for_exclusion": {"const": true},
            "provenance_required": {"const": true}
          }
        },
        "unknown_is_incomplete": {"const": true},
        "ambiguity_reason_required": {"type": "boolean"},
        "override_reason_required": {"type": "boolean"}
      }
    },
    "applicabilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_states", "default_state"],
      "properties": {
        "allowed_states": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["applicable", "not_applicable", "unknown"]},
          "uniqueItems": true
        },
        "default_state": {"enum": ["applicable", "not_applicable", "unknown"]}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/check"}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "section": {"enum": ["Team", "Business opportunity", "Product", "Documentation"]},
        "label": {"type": "string", "minLength": 1}
      }
    }
  }
}
