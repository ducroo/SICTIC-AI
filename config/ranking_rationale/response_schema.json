{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1}
        },
        "required": ["id", "rationale"]
      }
    }
  },
  "required": ["results"]
}
