{
  "$defs": {
    "quoted_string": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "quote": {"type": ["string", "null"]}
      }
    },
    "quoted_number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "quote": {"type": ["string", "null"]}
      }
    },
    "quoted_boolean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {"type": ["boolean", "null"]},
        "quote": {"type": ["string", "null"]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lenders", "borrower_name",
    "status", "status_evidence", "execution_date", "signatures_complete",
    "principal_total", "principal_currency",
    "interest_mode", "interest_rate_pct", "interest_day_count",
    "interest_compounding", "maturity_date",
    "qefr_present", "qefr_min_raise", "qefr_mandatory",
    "coc_present", "coc_mandatory",
    "maturity_conversion_present", "maturity_conversion_mandatory",
    "valuation_cap", "discount_pct", "discount_schedule", "valuation_floor",
    "denominator_basis", "subordinated", "subordination_scope",
    "mfn_clause", "pro_rata_rights", "conversion_capital_sources",
    "shareholder_consents_referenced", "sha_accession_required",
    "coc_repayment_multiple", "governing_law", "missing_terms"
  ],
  "properties": {
    "lenders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "domicile", "principal_amount", "quote"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {
            "type": "string",
            "enum": ["individual", "entity", "syndicate", "nominee", "unstated"]
          },
          "domicile": {
            "type": "string",
            "enum": ["CH", "other", "unstated"]
          },
          "principal_amount": {
            "type": ["number", "null"],
            "description": "This lender's own loan amount, if stated per lender."
          },
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "borrower_name": {"$ref": "#/$defs/quoted_string"},
    "status": {
      "type": "string",
      "enum": ["executed", "term_sheet", "converted", "repaid"]
    },
    "status_evidence": {"type": ["string", "null"]},
    "execution_date": {"$ref": "#/$defs/quoted_string"},
    "signatures_complete": {"$ref": "#/$defs/quoted_boolean"},
    "principal_total": {"$ref": "#/$defs/quoted_number"},
    "principal_currency": {"$ref": "#/$defs/quoted_string"},
    "interest_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {
          "type": "string",
          "enum": ["interest_free", "fixed", "safe_harbor_capped", "unstated"]
        },
        "quote": {"type": ["string", "null"]}
      }
    },
    "interest_rate_pct": {"$ref": "#/$defs/quoted_number"},
    "interest_day_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {
          "type": "string",
          "enum": ["act/act", "act/360", "act/365", "30/360", "unstated"]
        },
        "quote": {"type": ["string", "null"]}
      }
    },
    "interest_compounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {
          "type": "string",
          "enum": ["simple", "compound_annual", "compound_other", "unstated"]
        },
        "quote": {"type": ["string", "null"]}
      }
    },
    "maturity_date": {"$ref": "#/$defs/quoted_string"},
    "qefr_present": {"$ref": "#/$defs/quoted_boolean"},
    "qefr_min_raise": {"$ref": "#/$defs/quoted_number"},
    "qefr_mandatory": {"$ref": "#/$defs/quoted_boolean"},
    "coc_present": {"$ref": "#/$defs/quoted_boolean"},
    "coc_mandatory": {"$ref": "#/$defs/quoted_boolean"},
    "coc_repayment_multiple": {"$ref": "#/$defs/quoted_number"},
    "maturity_conversion_present": {"$ref": "#/$defs/quoted_boolean"},
    "maturity_conversion_mandatory": {"$ref": "#/$defs/quoted_boolean"},
    "valuation_cap": {"$ref": "#/$defs/quoted_number"},
    "discount_pct": {"$ref": "#/$defs/quoted_number"},
    "discount_schedule": {"$ref": "#/$defs/quoted_string"},
    "valuation_floor": {"$ref": "#/$defs/quoted_number"},
    "denominator_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {
          "type": "string",
          "enum": ["fully_diluted", "issued_and_outstanding", "unstated"]
        },
        "quote": {"type": ["string", "null"]}
      }
    },
    "subordinated": {"$ref": "#/$defs/quoted_boolean"},
    "subordination_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {
          "type": "string",
          "enum": ["loan_balance_full", "principal_only", "unclear", "not_subordinated"]
        },
        "quote": {"type": ["string", "null"]}
      }
    },
    "mfn_clause": {"$ref": "#/$defs/quoted_boolean"},
    "pro_rata_rights": {"$ref": "#/$defs/quoted_boolean"},
    "conversion_capital_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["consents", "conditional_capital", "kapitalband"]
          },
          "description": "All mechanisms the document contemplates; empty array when unstated."
        },
        "quote": {"type": ["string", "null"]}
      }
    },
    "shareholder_consents_referenced": {"$ref": "#/$defs/quoted_boolean"},
    "sha_accession_required": {"$ref": "#/$defs/quoted_boolean"},
    "governing_law": {"$ref": "#/$defs/quoted_string"},
    "missing_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "sections_scanned"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "sections_scanned": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
