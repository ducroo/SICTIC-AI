{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of_date", "share_classes", "stakeholders", "pools", "totals",
    "fully_diluted_definition", "assumptions"
  ],
  "properties": {
    "as_of_date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "quote": {"type": ["string", "null"]}
      }
    },
    "share_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "nominal_value", "votes_per_share"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "nominal_value": {"type": ["number", "null"]},
          "votes_per_share": {"type": ["number", "null"]}
        }
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "group", "kind", "role", "holdings",
          "diluted_count", "invested_amount"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "group": {
            "type": ["string", "null"],
            "description": "The group/category row this holder is listed under, verbatim."
          },
          "kind": {
            "type": "string",
            "enum": ["individual", "entity", "treasury",
                     "authorized_capital", "pool", "unknown"]
          },
          "role": {
            "type": "string",
            "enum": ["founder", "investor", "employee", "advisor", "board",
                     "departed", "company", "pool", "unknown"]
          },
          "holdings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["class_id", "count"],
              "properties": {
                "class_id": {"type": "string", "minLength": 1},
                "count": {"type": "number"}
              }
            }
          },
          "diluted_count": {
            "type": ["number", "null"],
            "description": "The fully-diluted share count for this holder if the table states one."
          },
          "invested_amount": {"type": ["number", "null"]}
        }
      }
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label", "total", "granted", "unallocated"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["esop", "psop", "grantable", "authorized_capital",
                     "treasury", "other"]
          },
          "label": {"type": "string", "minLength": 1},
          "total": {"type": ["number", "null"]},
          "granted": {"type": ["number", "null"]},
          "unallocated": {"type": ["number", "null"]}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by_class", "diluted_total", "quote"],
      "properties": {
        "by_class": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class_id", "issued_total"],
            "properties": {
              "class_id": {"type": "string", "minLength": 1},
              "issued_total": {"type": "number"}
            }
          }
        },
        "diluted_total": {"type": ["number", "null"]},
        "quote": {
          "type": ["string", "null"],
          "description": "Verbatim snippet of the totals row."
        }
      }
    },
    "fully_diluted_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote"],
      "properties": {
        "value": {
          "type": "string",
          "enum": ["full_pools", "granted_only", "granted_plus_vested",
                   "unstated"]
        },
        "quote": {"type": ["string", "null"]}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
