{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sector": {"type": "string", "description": "One configured SICTIC sector or insufficient evidence."},
    "sector_confidence": {"type": "string", "enum": ["H", "M", "L"]},
    "rationale": {"type": "string", "pattern": "\\S"},
    "evidence": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "pattern": "\\S"}
    }
  },
  "required": ["sector", "sector_confidence", "rationale", "evidence"],
  "allOf": [
    {
      "if": {"properties": {"sector": {"const": "insufficient evidence"}}},
      "then": {"properties": {"sector_confidence": {"const": "L"}}},
      "else": {"properties": {"evidence": {"minItems": 1}}}
    }
  ]
}
