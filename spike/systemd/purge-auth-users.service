[Unit]
Description=Purge Firebase Auth profiles older than 60 days
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
# Repo checkout path on the review host (symlink or real directory).
WorkingDirectory=/home/ubuntu/app
Environment=HOME=/home/ubuntu
Environment=REPO_PATH=/home/ubuntu/app
ExecStart=/home/ubuntu/miniforge3/envs/sictic-env/bin/python -m spike.purge_auth_users --days 60
Nice=10

[Install]
WantedBy=multi-user.target
